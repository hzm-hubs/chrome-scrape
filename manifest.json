{
	"manifest_version": 3,
	"name": "网页扫描",
	"version": "1.0",
	"description": "从网页提取目标数据",
	"permissions": [
		"contextMenus", // 右键菜单
		"activeTab", // 获取当前标签页
		"scripting", // 注入脚本
		"downloads", // 下载
		"https://open.feishu.cn/*",
		"webRequest"
	],
	"host_permissions": ["https://*.feishu.cn/*"],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": "icons/48.png"
	},
	"icons": {
		"16": "icons/16.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	}
}
