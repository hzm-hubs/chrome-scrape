{
	"manifest_version": 3,
	"name": "字段读取",
	"version": "1.0.0",
	"description": "从网页提取目标数据",
	"permissions": [
		"tabs",
		"activeTab",
		"scripting",
		"notifications",
		"storage",
		"runtime",
		"webRequest",
		"debugger"
	],
	"host_permissions": ["https://*/*", "http://*/*"],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://myseller.taobao.com/home.htm/*"],
			"js": ["content-script.js", "common/index.js", "myseller/index.js"]
		},
		{
			"matches": ["https://one.alimama.com/index.html*"],
			"js": ["content-script.js", "common/index.js", "myseller/index.js"]
		}
	],
	"action": {
		"default_popup": "popup/index.html",
		"default_icon": "icons/48.png"
	},
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png"
	}
}
