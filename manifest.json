{
	"manifest_version": 3,
	"name": "数据抓取",
	"version": "1.0.0",
	"description": "从网页提取目标数据",
	"permissions": [
		"contextMenus", // 右键菜单
		"activeTab", // 获取当前标签页
		"scripting", // 注入脚本
		"notifications", // 通知
		"tabs",
		"storage" // 内存
	],
	"host_permissions": ["https://*/*", "http://*/*"],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://*/*"],
			"js": ["content-script.js", "common/index.js"]
		}
	],
	"action": {
		"default_popup": "popup/index.html",
		"default_icon": "icons/48.png"
	},
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png"
	}
}
